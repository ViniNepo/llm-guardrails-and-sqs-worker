# Copie para .env e ajuste conforme necessário: `cp .env.example .env`
# Depois carregue no shell: `set -a; source .env; set +a`

# --- Conexão com a fila (modo LOCAL / ElasticMQ) ---
AWS_ENDPOINT_URL=http://localhost:9324
QUEUE_URL=http://localhost:9324/000000000000/session-closed

# Região e credenciais fictícias (o ElasticMQ não valida assinatura).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# --- Tuning do worker (todos têm default no código) ---
NUM_WORKERS=5
WAIT_TIME_SECONDS=1        # em produção use 20 (long polling). 1 acelera a demo local.
MAX_MESSAGES=10
VISIBILITY_TIMEOUT=30
HANDLE_TIMEOUT_SEC=45

# --- Só para o producer ---
N_MESSAGES=25

# ==========================================================================
# Em PRODUÇÃO (AWS real): deixe AWS_ENDPOINT_URL VAZIO/removido, use o QUEUE_URL
# real (https://sqs.<região>.amazonaws.com/<conta>/<fila>) e credenciais via IAM
# role (no ECS) ou perfil AWS. Recomenda-se WAIT_TIME_SECONDS=20.
# ==========================================================================
