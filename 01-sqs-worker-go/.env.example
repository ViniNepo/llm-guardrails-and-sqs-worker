# Copy to .env and adjust as needed: `cp .env.example .env`
# Then load it into your shell: `set -a; source .env; set +a`

# --- Queue connection (LOCAL mode / ElasticMQ) ---
AWS_ENDPOINT_URL=http://localhost:9324
QUEUE_URL=http://localhost:9324/000000000000/session-closed

# Dummy region and credentials (ElasticMQ does not validate signatures).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# --- Worker tuning (all have defaults in the code) ---
NUM_WORKERS=5
WAIT_TIME_SECONDS=1        # use 20 in production (long polling). 1 speeds up the local demo.
MAX_MESSAGES=10
VISIBILITY_TIMEOUT=30
HANDLE_TIMEOUT_SEC=45

# --- Producer only ---
N_MESSAGES=25

# ==========================================================================
# In PRODUCTION (real AWS): leave AWS_ENDPOINT_URL empty or remove it, use the
# real QUEUE_URL (https://sqs.<region>.amazonaws.com/<account>/<queue>) and
# credentials from an IAM role (on ECS) or an AWS profile. WAIT_TIME_SECONDS=20
# is recommended.
# ==========================================================================
